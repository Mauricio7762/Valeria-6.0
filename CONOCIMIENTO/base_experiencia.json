  "hechos": [
    {
      "id": "hecho_b25460a549",
      "texto": "El libro de las Habilidades de Comunicación es una parte del desarrollo personal y el proceso de comunicación interpersonal es definido en la asistencia de comunicación interpersonal.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_76add405a1",
      "texto": "El proceso de comunicación es esencial porque la comunicación es fundamental para compartir un significado común con los demás.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_79b49124c3",
      "texto": "Las habilidades sociales, junto con otros factores, determina la calidad de la vida y el éxito de las relaciones.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_f8127d84d5",
      "texto": "El objetivo es ser accesible sin exagerar en conceptos.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_2cbdef9357",
      "texto": "La idea es que el hecho de que no hay secundaria es parte del concepto de programación.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_61e7eca641",
      "texto": "Concepto de habilidades sociales es parte del PRINCIPAL y habilidad social es parte del concepto de conceptos sociales.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_2e51e68078",
      "texto": "El PRINCIPAL es parte del proceso de comunicación y el SECUNDARIA es parte del procesamiento de texto.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_748883e211",
      "texto": "El soporte de la información es parte del sistema principal.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    },
    {
      "id": "hecho_ef2917279d",
      "texto": "La idea se esencialmente dice que el mensaje no tiene secundaria.",
      "fuente_id": "doc_32ca8e0a5f",
      "fuente_tipo": "documento"
    }
  ],
