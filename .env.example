# ============================================
# VALERIA 6.0 - Variables de entorno
# ============================================
# Copia este archivo a .env (solo en Codespaces) o usá Codespaces Secrets.
# NO subas claves reales a GitHub.

# --- Entorno ---
VALERIA_ENV=development
VALERIA_DEBUG=true
VALERIA_LOG_LEVEL=INFO

# --- Capas activas (feature flags) ---
LAYER_0_ENABLED=true
LAYER_1_ENABLED=true
LAYER_2_ENABLED=true
LAYER_3_ENABLED=true
LAYER_4_ENABLED=true

# --- Sistema Glial ---
GLIAL_ASTROCYTES_ENABLED=true
GLIAL_OLIGODENDROCYTES_ENABLED=true
GLIAL_MICROGLIA_ENABLED=true
GLIAL_RADIAL_ENABLED=true

# --- Recursos ---
MAX_CPU_PERCENT=80
MAX_RAM_PERCENT=75
MAX_GPU_PERCENT=90

# --- Memoria (opcional / futuro) ---
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./DATA/MEMORY/chroma

# --- Visión / LLM (OpenAI · Groq · Kimi) ---
# Proveedor activo: openai | groq | kimi
VALERIA_VISION_PROVIDER=openai

OPENAI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
# MOONSHOT_API_KEY=

# Opcional
# VALERIA_VISION_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Seguridad ---
SECRET_KEY=cambia-esto-por-una-clave-segura
API_RATE_LIMIT=100/minute

# --- Dashboard ---
DASHBOARD_PORT=8501
API_PORT=8000
