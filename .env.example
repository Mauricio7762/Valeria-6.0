# ============================================
# VALERIA 6.0 - Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores

# --- Entorno ---
VALERIA_ENV=development          # development | staging | production
VALERIA_DEBUG=true
VALERIA_LOG_LEVEL=INFO

# --- Capas activas (feature flags) ---
LAYER_0_ENABLED=true
LAYER_1_ENABLED=false
LAYER_2_ENABLED=false
LAYER_3_ENABLED=false
LAYER_4_ENABLED=false

# --- Sistema Glial ---
GLIAL_ASTROCYTES_ENABLED=true
GLIAL_OLIGODENDROCYTES_ENABLED=true
GLIAL_MICROGLIA_ENABLED=true
GLIAL_RADIAL_ENABLED=true

# --- Recursos ---
MAX_CPU_PERCENT=80
MAX_RAM_PERCENT=75
MAX_GPU_PERCENT=90

# --- Memoria ---
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./DATA/MEMORY/chroma

# --- Modelos (placeholders) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- Seguridad ---
SECRET_KEY=cambia-esto-por-una-clave-segura
API_RATE_LIMIT=100/minute

# --- Dashboard ---
DASHBOARD_PORT=8501
API_PORT=8000
